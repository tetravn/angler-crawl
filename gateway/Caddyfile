# Gateway — gom các service về 1 port (Caddy reverse proxy theo path-prefix).
# handle_path tự strip prefix → service nhận đúng path native của nó.
#   /searxng/...      → searxng:8080      (vd: /searxng/search?q=...&format=json)
#   /flaresolverr/... → flaresolverr:8191 (vd: /flaresolverr/v1)
#   /firecrawl/...    → firecrawl-shim:8000 (API Firecrawl: /firecrawl/v1/scrape ...)
#
# KHÔNG có route tới crawl4ai. Engine chỉ gọi được qua shim (/v1/scrape...) — xem
# ghi chú ở chỗ đặt route cũ bên dưới.
#
# Địa chỉ site lấy từ ANGLER_SITE_ADDRESS, mặc định :80 (HTTP trần, dùng trong mạng nhà).
# Đặt biến này thành tên miền (vd angler.example.com) là Caddy tự xin và gia hạn chứng
# chỉ Let's Encrypt, không cần thêm cấu hình nào. Xem docker-compose.public.yml.
{$ANGLER_SITE_ADDRESS::80} {
	# Trần kích thước body. Không có nó thì một request POST khổng lồ được đọc hết vào
	# RAM của shim trước khi bất kỳ validation nào chạy. Chỉ thành vấn đề khi mở ra
	# internet, nhưng đặt sẵn thì mạng nhà cũng không mất gì.
	request_body {
		max_size {$ANGLER_MAX_BODY:10MB}
	}

	# Access log. Không có nó thì request đi thẳng vào backend không để lại dấu vết
	# ở đâu cả, và khi backend gây sự cố thì không truy được ai đã gọi (#17).
	# Ghi ra stdout để Docker lo phần xoay log (giới hạn đặt ở docker-compose.yml).
	log {
		output stdout
		format json
	}

	# Cổng API key (tuỳ chọn).
	# Đặt ANGLER_API_KEY trong .env để bật. Không đặt thì mở như cũ, chỉ dùng
	# trong mạng local, đúng thiết kế mặc định.
	# Khi bật, mọi request thiếu hoặc sai key đều bị chặn và chỉ nhận thông điệp
	# báo cần key, kể cả /docs, /openapi.json, / và /manifest.json. Agent có key
	# (gửi header Authorization: Bearer <key>) thì dò API và gọi bình thường.
	@unauthed expression `{env.ANGLER_API_KEY} != "" && {http.request.header.Authorization} != "Bearer "+{env.ANGLER_API_KEY}`
	# Health probe cho Docker healthcheck — đặt TRƯỚC gate auth nên không dính API key.
	handle /healthz {
		respond "OK" 200
	}
	handle @unauthed {
		header Content-Type application/json
		respond `{"error":"Angler: cần API key. Gửi header: Authorization: Bearer <key>"}` 401
	}

	# Upstream đặt qua biến vì ở chế độ VPN, searxng chạy trong network namespace của
	# gluetun (docker-compose.vpn.yml) nên không còn tên riêng — phải gọi qua gluetun:8080.
	# Mặc định giữ nguyên searxng:8080 cho chế độ không VPN.
	handle_path /searxng/* {
		reverse_proxy {$SEARXNG_UPSTREAM:searxng:8080}
	}
	# Không mở /crawl4ai/* nữa. Đường đó đi thẳng vào engine, bỏ qua toàn bộ xử lý của
	# shim: fallback FlareSolverr khi bị Cloudflare, phát hiện stub, cờ `blocked`, giãn
	# nhịp theo domain, giới hạn đồng thời. Nguồn bị chặn đi đường đó trả về y như trang
	# rỗng — tức là huỷ đúng phần đảm bảo chống thiên lệch mà stack này tồn tại vì nó.
	# Một burst qua đường này từng làm crawl4ai OOM mà không truy được ai gọi (#17).
	# Cần tham số nâng cao của crawl4ai thì gọi trong mạng docker (docker exec), đừng mở
	# lại route. /searxng/* và /flaresolverr/* thì giữ vì shim không thay thế được chúng.
	handle_path /flaresolverr/* {
		reverse_proxy flaresolverr:8191
	}
	# Firecrawl: SDK build URL bằng absolute path (/v1/.. /v2/..) nên path-prefix
	# bị drop. Vì vậy mount shim ở GỐC gateway cho /v1 + /v2 (giữ nguyên path).
	# → agent chỉ cần FIRECRAWL_API_URL=http://localhost:17300
	handle /v1/* {
		reverse_proxy firecrawl-shim:8000
	}
	handle /v2/* {
		reverse_proxy firecrawl-shim:8000
	}
	# Vẫn giữ /firecrawl/* (strip prefix) cho gọi tay / debug.
	handle_path /firecrawl/* {
		reverse_proxy firecrawl-shim:8000
	}

	# /health của shim. Trước đây không có route: request rơi vào nhánh không-khớp và
	# nhận 200 rỗng của Caddy, nên endpoint được ghi trong tài liệu mà thật ra chưa bao
	# giờ chạm tới shim — trông vẫn "sống" vì 200. Catch-all 404 ở cuối làm lộ ra.
	handle /health {
		reverse_proxy firecrawl-shim:8000
	}

	# ── Tài liệu API ở GỐC (URL ngắn, đoán được) → shim tự sinh OpenAPI ──
	# FastAPI phục vụ /openapi.json, /docs (Swagger UI), /redoc tại root của nó.
	handle /openapi.json {
		reverse_proxy firecrawl-shim:8000
	}
	handle /docs {
		reverse_proxy firecrawl-shim:8000
	}
	handle /docs/* {
		reverse_proxy firecrawl-shim:8000
	}
	handle /redoc {
		reverse_proxy firecrawl-shim:8000
	}

	# ── Discovery cho LLM agent ──
	# /llms.txt: mô tả ngắn dạng markdown cho LLM (người cũng đọc được).
	handle /llms.txt {
		root * /srv
		file_server
	}
	# /manifest.json: mục lục máy-đọc toàn stack (truy cập trực tiếp).
	handle /manifest.json {
		root * /srv
		file_server
	}

	# ── Trang gốc: content negotiation ──
	# Agent gửi Accept: application/json → trả manifest máy-đọc.
	# Trình duyệt (text/html) → trả landing page tĩnh.
	@agent_root {
		path /
		header Accept *application/json*
	}
	handle @agent_root {
		root * /srv
		rewrite * /manifest.json
		file_server
	}
	handle / {
		root * /srv
		rewrite * /index.html
		file_server
	}

	# Bắt mọi path không khớp route nào. Mặc định Caddy trả 200 rỗng, nên một endpoint
	# đã gỡ (vd /crawl4ai/* cũ) trông y hệt một request thành công không có nội dung —
	# caller không phân biệt được. Trả 404 kèm thông điệp để chỗ hỏng lộ ra ngay.
	handle {
		header Content-Type application/json
		respond `{"error":"Angler: endpoint không tồn tại. Xem /manifest.json hoặc /docs."}` 404
	}
}
